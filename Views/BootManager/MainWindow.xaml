<Window x:Class="BcdEditTool.Views.BootManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BcdEditTool.Views.BootManager"
        xmlns:vm="clr-namespace:BcdEditTool.ViewModels.BootManager"
        mc:Ignorable="d"
        Title="BCD Boot Manager — Multi-OS Fast Switcher"
        Height="780" Width="1060"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#18191C"
        Foreground="#EDEDED"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <local:InverseBoolConverter x:Key="InverseBoolConverter" />

        <!-- Accent Colors -->
        <SolidColorBrush x:Key="PrimaryAccent" Color="#0078D4" />
        <SolidColorBrush x:Key="PrimaryAccentHover" Color="#1988DE" />
        <SolidColorBrush x:Key="InstantBootBrush" Color="#D83B01" />
        <SolidColorBrush x:Key="InstantBootHoverBrush" Color="#EA4A0A" />
        <SolidColorBrush x:Key="CardBackground" Color="#232428" />
        <SolidColorBrush x:Key="CardBorder" Color="#33353B" />
        <SolidColorBrush x:Key="SubtleText" Color="#9CA3AF" />

        <!-- Card Style -->
        <Style x:Key="CardBorderBase" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Button Styles -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#303238" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#444750" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3E414A" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#555864" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#25272C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource PrimaryAccent}" />
            <Setter Property="BorderBrush" Value="#1084D9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="accentBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="accentBorder" Property="Background" Value="{StaticResource PrimaryAccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="accentBorder" Property="Background" Value="#005A9E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="accentBorder" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InstantBootButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource InstantBootBrush}" />
            <Setter Property="BorderBrush" Value="#E0460A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="instantBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="instantBorder" Property="Background" Value="{StaticResource InstantBootHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="instantBorder" Property="Background" Value="#B53000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="instantBorder" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Footer Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP HEADER BAR -->
        <Border Grid.Row="0" Background="#1F2024" BorderBrush="#2D2F35" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Brand & Elevation Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#0078D4" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="BCD Boot Manager" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                            <!-- Elevation Pill -->
                            <Border Margin="12,0,0,0" Padding="8,2" CornerRadius="4" VerticalAlignment="Center"
                                    Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisConverter}}">
                                <Border.Background>
                                    <SolidColorBrush Color="#143A27" />
                                </Border.Background>
                                <TextBlock Text="🛡️ Administrator" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80" />
                            </Border>

                            <Button Margin="12,0,0,0" Padding="8,2" Command="{Binding RestartElevatedCommand}"
                                    Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisConverter}, ConverterParameter=invert}"
                                    Style="{StaticResource ModernButton}" Background="#3A2510" BorderBrush="#D97706" Cursor="Hand">
                                <TextBlock Text="⚠️ Non-Elevated — Click to Elevate" FontSize="11" FontWeight="SemiBold" Foreground="#FBBF24" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Multi-Windows Boot Configuration &amp; Instant Boot Switcher" FontSize="12" Foreground="{StaticResource SubtleText}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Header Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Backup BCD Button -->
                    <Button Content="💾 Backup BCD" Style="{StaticResource ModernButton}" Click="OnBackupBcdClick" Margin="0,0,10,0" />

                    <!-- Refresh Button -->
                    <Button Content="🔄 Refresh Drives &amp; BCD" Style="{StaticResource AccentButton}" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN SCROLLABLE CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20" MaxWidth="1200">

                <!-- ELEVATION WARNING NOTICE (IF NOT ELEVATED) -->
                <Border Margin="0,0,0,16" Padding="14,12" Background="#261C14" BorderBrush="#B45309" BorderThickness="1" CornerRadius="8"
                        Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisConverter}, ConverterParameter=invert}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Administrator Privileges Required for BCD Operations" FontWeight="Bold" Foreground="#FBBF24" FontSize="13" />
                            <TextBlock Text="Windows requires elevated permissions to modify the BCD store or trigger instant boot commands. Click Elevate to restart as Administrator."
                                       Foreground="#D1D5DB" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="🛡️ Restart Elevated" Style="{StaticResource ModernButton}"
                                Command="{Binding RestartElevatedCommand}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    </Grid>
                </Border>

                <!-- SECTION 1: DETECTED DRIVES & DISKS -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💾 Storage Drives &amp; Partitions" FontSize="15" FontWeight="SemiBold" Foreground="#F3F4F6" />
                        <Border Margin="10,0,0,0" Padding="6,2" CornerRadius="10" Background="#2E3138" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Drives.Count, StringFormat='{}{0} Drives Scanned'}" FontSize="11" Foreground="#9CA3AF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding TotalWindowsInstallationsCount, StringFormat='{}{0} Windows installations detected on disk'}"
                               FontSize="12" Foreground="#60A5FA" VerticalAlignment="Center" />
                </Grid>

                <!-- Drives Cards Grid -->
                <ItemsControl ItemsSource="{Binding Drives}" Margin="0,0,0,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderBase}" Width="240" Margin="0,0,12,12" Padding="12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DriveLetter}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                                            <TextBlock Text="{Binding VolumeLabel, StringFormat=' [{0}]'}" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding FileSystem}" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Capacity & Usage Bar -->
                                    <ProgressBar Value="{Binding UsedPercentage, Mode=OneWay}" Maximum="100" Height="5" Margin="0,4,0,4"
                                                 Foreground="#0078D4" Background="#1A1C20" BorderThickness="0" />
                                    <Grid Margin="0,2,0,6">
                                        <TextBlock Text="{Binding FormattedFreeSize, StringFormat='{}{0} free'}" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding FormattedTotalSize, StringFormat='{}of {0}'}" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Windows Installation Badge -->
                                    <Border Margin="0,4,0,0" Padding="6,3" CornerRadius="4"
                                            Visibility="{Binding HasWindowsInstallation, Converter={StaticResource BoolToVisConverter}}">
                                        <Border.Background>
                                            <SolidColorBrush Color="#16382B" />
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🪟 " FontSize="11" />
                                            <TextBlock Text="{Binding WindowsFriendlyEdition}" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- SECTION 2: BCD BOOT LOADER ENTRIES -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🚀 Boot Loader Operating Systems" FontSize="15" FontWeight="SemiBold" Foreground="#F3F4F6" />
                        <Border Margin="10,0,0,0" Padding="6,2" CornerRadius="10" Background="#2E3138" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Entries.Count, StringFormat='{}{0} Available'}" FontSize="11" Foreground="#9CA3AF" />
                        </Border>
                    </StackPanel>

                    <!-- Boot Timeout Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Boot Menu Timeout:" FontSize="12" Foreground="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding BootTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="44" TextAlignment="Center"
                                 Background="#26282E" Foreground="#FFFFFF" BorderBrush="#3F424A" BorderThickness="1" Padding="4,2"
                                 FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="sec" FontSize="12" Foreground="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="Set" Style="{StaticResource ModernButton}" Command="{Binding SaveTimeoutCommand}" Padding="8,4" FontSize="11" />
                    </StackPanel>
                </Grid>

                <!-- Boot Entries Cards List -->
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderBase}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- CARD ROW 1: Title, Inline Edit, and Status Badges -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- LEFT: Normal Display Mode -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}, ConverterParameter=invert}">
                                            <TextBlock Text="{Binding Description}" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            <Button Content="✏️ Edit Name" Style="{StaticResource ModernButton}" Command="{Binding StartEditCommand}"
                                                    Margin="12,0,0,0" Padding="8,3" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- LEFT: Inline Edit Mode -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBox Text="{Binding EditedDescription, UpdateSourceTrigger=PropertyChanged}" Width="320"
                                                     Background="#18191C" Foreground="#FFFFFF" BorderBrush="#0078D4" BorderThickness="1.5"
                                                     Padding="8,5" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Button Content="✔ Save" Style="{StaticResource AccentButton}" Command="{Binding SaveEditCommand}"
                                                    Margin="8,0,0,0" Padding="10,4" FontSize="12" VerticalAlignment="Center" />
                                            <Button Content="✖ Cancel" Style="{StaticResource ModernButton}" Command="{Binding CancelEditCommand}"
                                                    Margin="6,0,0,0" Padding="8,4" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- RIGHT: System Badges (Current, Default) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Current Running OS Badge -->
                                            <Border Margin="0,0,8,0" Padding="8,3" CornerRadius="4"
                                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisConverter}}">
                                                <Border.Background>
                                                    <SolidColorBrush Color="#133E2B" />
                                                </Border.Background>
                                                <TextBlock Text="● CURRENT RUNNING OS" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                                            </Border>

                                            <!-- Default Boot OS Badge -->
                                            <Border Padding="8,3" CornerRadius="4"
                                                    Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisConverter}}">
                                                <Border.Background>
                                                    <SolidColorBrush Color="#1E2A4A" />
                                                </Border.Background>
                                                <TextBlock Text="★ DEFAULT BOOT OS" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- CARD ROW 2: GUID, Partition, Windows Build & Path Details -->
                                    <Border Grid.Row="1" Background="#1D1E22" BorderBrush="#2C2E34" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Column 1: Unique Identifier (Strict GUID) -->
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="UNIQUE IDENTIFIER (GUID)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SubtleText}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding Identifier}" FontSize="12" FontFamily="Consolas, monospace" Foreground="#E5E7EB" VerticalAlignment="Center" />
                                                    <Button Content="📋" ToolTip="Copy GUID to Clipboard" Command="{Binding CopyGuidCommand}"
                                                            Style="{StaticResource ModernButton}" Padding="4,1" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding StatusNotice}" FontSize="10" Foreground="#34D399" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Column 2: Partition & Drive Information -->
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="PARTITION &amp; STORAGE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SubtleText}" />
                                                <TextBlock Text="{Binding PartitionSummary}" FontSize="12" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding DetectedWindowsVersion}" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Column 3: Loader Path & Root -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="BOOTLOADER BINARY &amp; ROOT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SubtleText}" />
                                                <TextBlock Text="{Binding Path}" FontSize="12" FontFamily="Consolas, monospace" Foreground="#D1D5DB" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding SystemRoot, StringFormat='System Root: {0}'}" FontSize="11" Foreground="#6B7280" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- CARD ROW 3: Action Buttons (Instant Boot without prompt & Set Default) -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Notice on Instant Boot -->
                                        <TextBlock Grid.Column="0" Text="Clicking Instant Boot sets next boot sequence to this entry and immediately restarts PC without confirmation."
                                                   FontSize="11" Foreground="{StaticResource SubtleText}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                        <!-- Buttons -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Set As Default Button -->
                                            <Button Content="★ Set as Default" Style="{StaticResource ModernButton}" Command="{Binding SetDefaultCommand}"
                                                    IsEnabled="{Binding IsDefault, Converter={StaticResource InverseBoolConverter}}"
                                                    Margin="0,0,10,0" Padding="14,8" />

                                            <!-- INSTANT BOOT BUTTON (ONE-CLICK, NO PROMPT) -->
                                            <Button Style="{StaticResource InstantBootButton}" Command="{Binding InstantBootCommand}"
                                                    ToolTip="Directly reboots into this operating system immediately without prompt"
                                                    Padding="16,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Instant Boot" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- EMPTY STATE / NO ENTRIES NOTICE -->
                <Border Style="{StaticResource CardBorderBase}" Padding="30" Margin="0,20,0,0"
                        Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisConverter}, ConverterParameter=invert}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="No BCD Boot Loader Entries Loaded" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                        <TextBlock Text="If running without elevation, please launch as Administrator to allow bcdedit access."
                                   FontSize="13" Foreground="{StaticResource SubtleText}" HorizontalAlignment="Center" Margin="0,4,0,16" />
                        <Button Content="🛡️ Launch as Administrator" Style="{StaticResource AccentButton}" Command="{Binding RestartElevatedCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="#141518" BorderBrush="#25272C" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status: " FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SubtleText}" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#E5E7EB" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusTimestamp, StringFormat='{}Last updated: {0:HH:mm:ss}'}"
                               FontSize="11" Foreground="{StaticResource SubtleText}" Margin="0,0,16,0" />
                    <TextBlock Text="v1.0 Standalone" FontSize="11" Foreground="#4B5563" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
